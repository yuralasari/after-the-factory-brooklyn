
---
import PageLayout from "@layouts/PageLayout.astro";
import { FullPageMap, loadMapConfig } from "@maplibre-yaml/astro";

const map = await loadMapConfig("./src/maps/after-the-factory.yaml");
---

<PageLayout
  title="After the Factory | Brooklyn"
  description="Industrial Persistence and Transformation in Brooklyn"
  bleed
>
  <FullPageMap
    config={map}
    style="top: var(--header-h); height: calc(100vh - var(--header-h));"
  >
    <div
      slot="top-left"
      class="hidden sm:block rounded bg-white/90 px-3 py-3 text-sm text-stone-700 shadow max-w-72"
    >
      <strong>AFTER THE FACTORY</strong>
      <p class="mt-2">
        Industrial Persistence and Transformation in Brooklyn, NYC
      </p>
      <p class="mt-2">
        Explore ten selected adaptive reuse sites alongside
        industrial land use and their surrounding 400-meter
        analysis areas.
      </p>
      <p class="mt-2 text-xs">
        Use the layer panel to compare spatial relationships.
      </p>
    </div>
  </FullPageMap>
</PageLayout>
